local espCache = {}

local function removeESP(p)
	if espCache[p] then
		if espCache[p].box then espCache[p].box:Destroy() end
		if espCache[p].line then espCache[p].line:Remove() end
		if espCache[p].verPlayPart then espCache[p].verPlayPart:Destroy() end
		if espCache[p].skeletonLines then
			for _, l in pairs(espCache[p].skeletonLines) do
				l:Remove()
			end
		end
		espCache[p] = nil
	end
end

local function setupPlayer(p)
	if p == player then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DV_ESP"
	billboard.Size = UDim2.new(4, 0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local boxFrame = Instance.new("Frame")
	boxFrame.Size = UDim2.new(1, 0, 1, 0)
	boxFrame.BackgroundTransparency = 1
	boxFrame.Parent = billboard

	local boxStroke = Instance.new("UIStroke")
	boxStroke.Color = boxColor
	boxStroke.Thickness = 1.5
	boxStroke.Parent = boxFrame

	local tracerLine
	local skelLines = {}
	if Drawing then
		tracerLine = Drawing.new("Line")
		tracerLine.Visible = false
		tracerLine.Thickness = 1.5
		tracerLine.Transparency = 1

		for i = 1, 8 do
			local l = Drawing.new("Line")
			l.Visible = false
			l.Thickness = 1.2
			l.Transparency = 1
			table.insert(skelLines, l)
		end
	end

	espCache[p] = {
		box = billboard,
		stroke = boxStroke,
		line = tracerLine,
		skeletonLines = skelLines,
		verPlayPart = nil
	}

	p.CharacterAdded:Connect(function(char)
		billboard.Adornee = char:WaitForChild("HumanoidRootPart", 5)
		billboard.Parent = char
	end)

	if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
		billboard.Adornee = p.Character.HumanoidRootPart
		billboard.Parent = p.Character
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	setupPlayer(p)
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	for p, data in pairs(espCache) do
		local char = p.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local rootPart = char and char:FindFirstChild("HumanoidRootPart")
		local head = char and char:FindFirstChild("Head")

		if char and humanoid and rootPart and humanoid.Health > 0 then
			-- Box ESP
			if boxEnabled then
				data.box.Enabled = true
				data.stroke.Transparency = 0
				data.stroke.Color = boxColor
			else
				data.box.Enabled = false
			end

			-- Matar 😈
			if head then
				if matarEnabled then
					head.Size = Vector3.new(6, 6, 6)
					head.Transparency = 0.7
					head.CanCollide = false
				else
					head.Size = Vector3.new(2, 1, 1)
					head.Transparency = 0
					head.CanCollide = true
				end
			end

			-- Ver Play 😈
			if verPlayEnabled then
				if not data.verPlayPart or not data.verPlayPart.Parent then
					local part = Instance.new("Part")
					part.Name = "DV_VerPlay"
					part.Size = Vector3.new(1.5, 80, 1.5)
					part.CFrame = rootPart.CFrame * CFrame.new(0, 40, 0)
					part.Transparency = 0.4
					part.BrickColor = BrickColor.new("Really red")
					part.Material = Enum.Material.Neon
					part.CanCollide = false
					part.Massless = true

					local weld = Instance.new("WeldConstraint")
					weld.Part0 = rootPart
					weld.Part1 = part
					weld.Parent = part

					part.Parent = char
					data.verPlayPart = part
				end
			else
				if data.verPlayPart then
					data.verPlayPart:Destroy()
					data.verPlayPart = nil
				end
			end

			-- Esplinha (Tracer)
			if linhaEnabled and data.line then
				local vector, onScreen = camera:WorldToViewportPoint(rootPart.Position)
				if onScreen then
					data.line.Color = linhaColor
					data.line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
					data.line.To = Vector2.new(vector.X, vector.Y)
					data.line.Visible = true
				else
					data.line.Visible = false
				end
			elseif data.line then
				data.line.Visible = false
			end

			-- Esqueleto ESP
			if esqueletoEnabled and data.skeletonLines then
				local upperTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
				local lowerTorso = char:FindFirstChild("LowerTorso") or upperTorso
				local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
				local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
				local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
				local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

				local bones = {
					{head, upperTorso},
					{upperTorso, lowerTorso},
					{upperTorso, leftArm},
					{upperTorso, rightArm},
					{lowerTorso, leftLeg},
					{lowerTorso, rightLeg}
				}

				for i, bone in ipairs(bones) do
					local lObj = data.skeletonLines[i]
					if lObj and bone[1] and bone[2] then
						local p1, on1 = camera:WorldToViewportPoint(bone[1].Position)
						local p2, on2 = camera:WorldToViewportPoint(bone[2].Position)
						if on1 or on2 then
							lObj.Color = esqueletoColor
							lObj.From = Vector2.new(p1.X, p1.Y)
							lObj.To = Vector2.new(p2.X, p2.Y)
							lObj.Visible = true
						else
							lObj.Visible = false
						end
					elseif lObj then
						lObj.Visible = false
					end
				end
			else
				if data.skeletonLines then
					for _, l in pairs(data.skeletonLines) do
						l.Visible = false
					end
				end
			end
		else
			data.box.Enabled = false
			if data.verPlayPart then
				data.verPlayPart:Destroy()
				data.verPlayPart = nil
			end
			if data.line then data.line.Visible = false end
			if data.skeletonLines then
				for _, l in pairs(data.skeletonLines) do l.Visible = false end
			end
		end
	end
end)

--==================================================
