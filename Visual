--==================================================
-- ABRIR / FECHAR
--==================================================

local aberto = false
local tamanho = UDim2.fromOffset(215,285)

local function abrir()
	aberto = true
	frame.Visible = true
	frame.Size = UDim2.fromOffset(0,0)
	TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = tamanho}):Play()
end

local function fechar()
	aberto = false
	local anim = TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0,0)})
	anim:Play()
	anim.Completed:Connect(function()
		if not aberto then
			frame.Visible = false
			frame.Size = tamanho
		end
	end)
end

